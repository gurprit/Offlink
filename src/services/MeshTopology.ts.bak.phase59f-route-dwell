import {MeshNode} from '../models/MeshNode';
import {
  recordRemoteRouteApplied,
  recordRemoteRouteSkippedDirect,
  recordRemoteRouteSkippedSelf,
  recordRemoteRouteSkippedWorse,
} from './MeshDiagnosticsService';
import {
  recordRouteObservation,
  recordRouteSelected,
} from './MeshRouteMemory';
import {
  scoreMeshRoute,
} from './MeshRouteScoring';

const DIRECT_ROUTE_ACTIVE_MS = 25_000;
const DIRECT_ROUTE_RETENTION_MS = 60_000;
const REMOTE_ROUTE_TIMEOUT_MS = 300_000;
const CLEANUP_INTERVAL_MS = 5_000;
const REMOTE_ROUTE_SWITCH_THRESHOLD = 8;
const MAX_REMOTE_REPORTED_QUALITY = 92;

const MIN_NORMAL_REMOTE_QUALITY = 30;
const MAX_NORMAL_REMOTE_HOPS = 4;

const MIN_EMERGENCY_REMOTE_QUALITY = 15;
const MAX_EMERGENCY_REMOTE_HOPS = 6;

type RouteKind = 'direct' | 'remote';

interface MeshRouteCandidate extends MeshNode {
  routeKind: RouteKind;
}

function calculateQuality(rssi: number): number {
  if (rssi >= -50) {
    return 100;
  }

  if (rssi <= -95) {
    return 5;
  }

  return Math.round(((rssi + 95) / 45) * 95 + 5);
}

function getRouteKey(kind: RouteKind, via: string | null): string {
  return kind === 'direct' ? 'direct' : `remote:${via ?? 'unknown'}`;
}

class MeshTopologyStore {
  /**
   * Destination ID -> candidate route key -> candidate route.
   *
   * A destination can therefore retain:
   * - one direct BLE candidate
   * - one remote candidate per relay node
   */
  private routeCandidates = new Map<
    string,
    Map<string, MeshRouteCandidate>
  >();

  private listeners = new Set<() => void>();
  private selfMeshId: string | null = null;
  private selectedRouteKeyByDestination =
    new Map<string, string>();

  setSelfMeshId(meshId: string | null) {
    this.selfMeshId = meshId;
    this.removeSelfRoutes();
  }

  updateNode(
    id: string,
    name: string,
    rssi: number,
    hops = 1,
    via: string | null = null,
    userId?: string,
  ) {
    if (this.isSelfRoute(id, via)) {
      recordRemoteRouteSkippedSelf();
      recordRemoteRouteSkippedDirect();
      return;
    }

    const now = Date.now();
    const routeKey = getRouteKey('direct', null);
    const candidates = this.getOrCreateCandidates(id);
    const existing = candidates.get(routeKey);

    const quality = calculateQuality(rssi);
    const routeScore = scoreMeshRoute({
      destinationId: id,
      quality,
      hops: 1,
      connected: true,
      ageMs: 0,
      via: null,
    }).totalScore;

    candidates.set(routeKey, {
      ...(existing ?? {}),
      id,
      userId: userId ?? existing?.userId,
      name,
      rssi,
      quality,
      routeScore,
      routeReason: 'fresh direct BLE route',
      firstSeen: existing?.firstSeen ?? now,
      lastSeen: now,
      lastUpdated: now,
      hops: 1,
      via: null,
      discoveredVia: 'direct',
      connected: true,
      routeKind: 'direct',
    });

    console.log(
      'OFFLINK_ADAPTIVE_DIRECT_CANDIDATE',
      JSON.stringify({
        id,
        quality,
        routeScore,
      }),
    );

    this.trackSelectedRoute(
      id,
      this.selectBestRoute(id, now),
    );

    this.notify();
  }

  updateRemoteNode(
    id: string,
    name: string,
    quality: number,
    hops: number,
    via: string,
    userId?: string,
  ) {
    if (this.isSelfRoute(id, via) || id === via) {
      recordRemoteRouteSkippedSelf();
      return;
    }

    const now = Date.now();
    /*
     * A relay can report Q100 because it sees the destination directly,
     * but that does not mean our complete multi-hop path is perfect.
     * Keep remote quality below the direct-route ceiling.
     */
    const safeQuality = Math.max(
      0,
      Math.min(
        MAX_REMOTE_REPORTED_QUALITY,
        Math.round(quality),
      ),
    );

    const safeHops = Math.max(2, Math.round(hops));
    const estimatedRssi = Math.round(-95 + (safeQuality / 100) * 45);

    const routeKey = getRouteKey('remote', via);
    const candidates = this.getOrCreateCandidates(id);
    const existing = candidates.get(routeKey);

    const routeScore = scoreMeshRoute({
      destinationId: id,
      quality: safeQuality,
      hops: safeHops,
      connected: false,
      ageMs: 0,
      via,
    }).totalScore;

    recordRouteObservation({
      destinationId: id,
      via,
      quality: safeQuality,
    });

    candidates.set(routeKey, {
      ...(existing ?? {}),
      id,
      userId: userId ?? existing?.userId,
      name,
      rssi: estimatedRssi,
      quality: safeQuality,
      routeScore,
      routeReason: `remote candidate via ${via}`,
      firstSeen: existing?.firstSeen ?? now,
      lastSeen: now,
      lastUpdated: now,
      hops: safeHops,
      via,
      discoveredVia: `via ${via}`,
      connected: false,
      routeKind: 'remote',
    });

    recordRemoteRouteApplied();

    const selected = this.selectBestRoute(id, now);
    this.trackSelectedRoute(id, selected);

    if (
      selected &&
      selected.routeKind !== 'remote' &&
      selected.via !== via
    ) {
      recordRemoteRouteSkippedWorse();
    }

    console.log(
      'OFFLINK_ADAPTIVE_REMOTE_CANDIDATE',
      JSON.stringify({
        id,
        via,
        hops: safeHops,
        quality: safeQuality,
        routeScore,
        selectedVia: selected?.via ?? 'direct',
        selectedKind: selected?.routeKind ?? null,
      }),
    );

    this.notify();
  }

  removeExpiredNodes() {
    const now = Date.now();
    let changed = false;

    for (const [id, candidates] of this.routeCandidates) {
      for (const [routeKey, candidate] of candidates) {
        const ageMs = now - candidate.lastSeen;
        const timeoutMs =
          candidate.routeKind === 'direct'
            ? DIRECT_ROUTE_RETENTION_MS
            : REMOTE_ROUTE_TIMEOUT_MS;

        if (ageMs > timeoutMs) {
          candidates.delete(routeKey);
          changed = true;

          console.log(
            'OFFLINK_ADAPTIVE_CANDIDATE_EXPIRED',
            JSON.stringify({
              id,
              routeKey,
              ageMs,
            }),
          );
        }
      }

      if (candidates.size === 0) {
        this.routeCandidates.delete(id);
        changed = true;
      }
    }

    if (changed) {
      this.notify();
      return;
    }

    /*
     * Route freshness changes with time even when no candidate expires.
     * Notify subscribers so diagnostics can show automatic handovers.
     */
    this.notify();
  }

  getTopology(): MeshNode[] {
    const now = Date.now();
    const selectedRoutes: MeshNode[] = [];

    for (const id of this.routeCandidates.keys()) {
      const selected = this.selectBestRoute(id, now);

      if (selected) {
        selectedRoutes.push(this.toPublicNode(selected, now));
      }
    }

    return selectedRoutes.sort((a, b) => {
      const scoreDiff =
        (b.routeScore ?? b.quality) - (a.routeScore ?? a.quality);

      if (scoreDiff !== 0) {
        return scoreDiff;
      }

      if (a.hops !== b.hops) {
        return a.hops - b.hops;
      }

      return b.lastSeen - a.lastSeen;
    });
  }

  /**
   * GATT operations must only target devices that are physically and
   * recently reachable over BLE. Remote mesh routes are deliberately
   * excluded here.
   */
  getNearestNodes(): MeshNode[] {
    const now = Date.now();
    const directNodes: MeshNode[] = [];

    for (const candidates of this.routeCandidates.values()) {
      const direct = candidates.get(getRouteKey('direct', null));

      if (
        direct &&
        now - direct.lastSeen <= DIRECT_ROUTE_ACTIVE_MS
      ) {
        directNodes.push(this.toPublicNode(direct, now));
      }
    }

    return directNodes.sort((a, b) => b.rssi - a.rssi);
  }

  subscribe(listener: () => void): () => void {
    this.listeners.add(listener);

    return () => {
      this.listeners.delete(listener);
    };
  }

  clear() {
    this.routeCandidates.clear();
    this.selectedRouteKeyByDestination.clear();
    this.notify();
  }

  private trackSelectedRoute(
    destinationId: string,
    selected: MeshRouteCandidate | null,
  ) {
    if (!selected) {
      this.selectedRouteKeyByDestination.delete(
        destinationId,
      );
      return;
    }

    const selectedKey = getRouteKey(
      selected.routeKind,
      selected.via,
    );

    const previousKey =
      this.selectedRouteKeyByDestination.get(
        destinationId,
      );

    if (previousKey === selectedKey) {
      return;
    }

    this.selectedRouteKeyByDestination.set(
      destinationId,
      selectedKey,
    );

    if (
      selected.routeKind === 'remote' &&
      selected.via
    ) {
      recordRouteSelected({
        destinationId,
        via: selected.via,
      });
    }

    console.log(
      'OFFLINK_ADAPTIVE_ROUTE_CHANGED',
      JSON.stringify({
        destinationId,
        previousRoute: previousKey ?? null,
        selectedRoute: selectedKey,
        selectedVia: selected.via,
        selectedKind: selected.routeKind,
        hops: selected.hops,
        quality: selected.quality,
      }),
    );
  }

  private getOrCreateCandidates(
    id: string,
  ): Map<string, MeshRouteCandidate> {
    const existing = this.routeCandidates.get(id);

    if (existing) {
      return existing;
    }

    const created = new Map<string, MeshRouteCandidate>();
    this.routeCandidates.set(id, created);

    return created;
  }

  private selectBestRoute(
    id: string,
    now = Date.now(),
  ): MeshRouteCandidate | null {
    const candidates = this.routeCandidates.get(id);

    if (!candidates || candidates.size === 0) {
      return null;
    }

    const scoredCandidates = [...candidates.values()]
      .filter(candidate => {
        const ageMs = now - candidate.lastSeen;

        if (candidate.routeKind === 'direct') {
          return ageMs <= DIRECT_ROUTE_ACTIVE_MS;
        }

        return ageMs <= REMOTE_ROUTE_TIMEOUT_MS;
      })
      .map(candidate => {
        const ageMs = now - candidate.lastSeen;
        const connected =
          candidate.routeKind === 'direct' &&
          ageMs <= DIRECT_ROUTE_ACTIVE_MS;

        const scoring = scoreMeshRoute(
          {
            destinationId: candidate.id,
            quality: candidate.quality,
            hops: candidate.hops,
            connected,
            ageMs,
            via: candidate.via,
          },
          now,
        );

        return {
          ...candidate,
          connected,
          routeScore: scoring.totalScore,
          routeReason: scoring.reason,
        };
      });

    const directCandidates = scoredCandidates.filter(
      candidate => candidate.routeKind === 'direct',
    );

    const normalRemoteCandidates = scoredCandidates.filter(
      candidate =>
        candidate.routeKind === 'remote' &&
        candidate.quality >= MIN_NORMAL_REMOTE_QUALITY &&
        candidate.hops <= MAX_NORMAL_REMOTE_HOPS,
    );

    const emergencyRemoteCandidates = scoredCandidates.filter(
      candidate =>
        candidate.routeKind === 'remote' &&
        candidate.quality >= MIN_EMERGENCY_REMOTE_QUALITY &&
        candidate.hops <= MAX_EMERGENCY_REMOTE_HOPS,
    );

    const eligible =
      directCandidates.length > 0
        ? directCandidates
        : normalRemoteCandidates.length > 0
          ? normalRemoteCandidates
          : emergencyRemoteCandidates;

    if (eligible.length === 0) {
      console.log(
        'OFFLINK_ROUTE_REJECTED_NO_VIABLE_CANDIDATE',
        JSON.stringify({
          destinationId: id,
          candidates: scoredCandidates.map(candidate => ({
            kind: candidate.routeKind,
            via: candidate.via,
            quality: candidate.quality,
            hops: candidate.hops,
            routeScore: candidate.routeScore,
          })),
        }),
      );

      return null;
    }

    /*
     * A route that is still physically visible over BLE remains the
     * preferred path. Learned history helps choose between relays, but
     * must never displace a genuinely fresh direct connection.
     */
    const freshDirect = eligible.find(
      candidate => candidate.routeKind === 'direct',
    );

    if (freshDirect) {
      return freshDirect;
    }

    eligible.sort((a, b) => {
      const scoreDiff =
        (b.routeScore ?? b.quality) - (a.routeScore ?? a.quality);

      if (scoreDiff !== 0) {
        return scoreDiff;
      }

      if (a.hops !== b.hops) {
        return a.hops - b.hops;
      }

      return b.lastSeen - a.lastSeen;
    });

    const bestCandidate = eligible[0];

    if (
      bestCandidate.routeKind === 'remote' &&
      (
        bestCandidate.quality < MIN_NORMAL_REMOTE_QUALITY ||
        bestCandidate.hops > MAX_NORMAL_REMOTE_HOPS
      )
    ) {
      bestCandidate.routeReason =
        `emergency fallback: ${bestCandidate.routeReason}`;

      console.log(
        'OFFLINK_EMERGENCY_ROUTE_SELECTED',
        JSON.stringify({
          destinationId: id,
          via: bestCandidate.via,
          quality: bestCandidate.quality,
          hops: bestCandidate.hops,
          routeScore: bestCandidate.routeScore,
        }),
      );
    }
    const previousRouteKey =
      this.selectedRouteKeyByDestination.get(id);

    /*
     * Prevent two similar relays from repeatedly swapping places.
     * The challenger must beat the currently selected remote route by
     * a meaningful margin before we switch.
     */
    if (
      previousRouteKey?.startsWith('remote:') &&
      bestCandidate.routeKind === 'remote'
    ) {
      const previousCandidate = eligible.find(candidate => {
        return (
          getRouteKey(
            candidate.routeKind,
            candidate.via,
          ) === previousRouteKey
        );
      });

      if (previousCandidate) {
        const bestScore =
          bestCandidate.routeScore ??
          bestCandidate.quality;

        const previousScore =
          previousCandidate.routeScore ??
          previousCandidate.quality;

        if (
          bestScore <
          previousScore +
            REMOTE_ROUTE_SWITCH_THRESHOLD
        ) {
          return previousCandidate;
        }
      }
    }

    return bestCandidate;
  }

  private toPublicNode(
    candidate: MeshRouteCandidate,
    now: number,
  ): MeshNode {
    const ageMs = now - candidate.lastSeen;
    const connected =
      candidate.routeKind === 'direct' &&
      ageMs <= DIRECT_ROUTE_ACTIVE_MS;

    const scoring = scoreMeshRoute(
      {
        destinationId: candidate.id,
        quality: candidate.quality,
        hops: candidate.hops,
        connected,
        ageMs,
        via: candidate.via,
      },
      now,
    );

    const routeScore = scoring.totalScore;

    return {
      id: candidate.id,
      userId: candidate.userId,
      name: candidate.name,
      rssi: candidate.rssi,
      quality: candidate.quality,
      firstSeen: candidate.firstSeen,
      lastSeen: candidate.lastSeen,
      lastUpdated: candidate.lastUpdated,
      hops: candidate.hops,
      via: candidate.via,
      discoveredVia: candidate.discoveredVia,
      connected,
      routeScore,
      routeReason: connected
        ? `selected direct: ${scoring.reason}`
        : `selected via ${candidate.via}: ${scoring.reason}`,
    };
  }

  private isSelfRoute(id: string, via: string | null): boolean {
    return Boolean(
      this.selfMeshId &&
        (id === this.selfMeshId || via === this.selfMeshId),
    );
  }

  private removeSelfRoutes() {
    if (!this.selfMeshId) {
      return;
    }

    let changed = false;

    for (const [id, candidates] of this.routeCandidates) {
      if (id === this.selfMeshId) {
        this.routeCandidates.delete(id);
        changed = true;
        continue;
      }

      for (const [routeKey, candidate] of candidates) {
        if (
          candidate.id === this.selfMeshId ||
          candidate.via === this.selfMeshId
        ) {
          candidates.delete(routeKey);
          changed = true;
        }
      }

      if (candidates.size === 0) {
        this.routeCandidates.delete(id);
        changed = true;
      }
    }

    if (changed) {
      this.notify();
    }
  }

  private notify() {
    setTimeout(() => {
      this.listeners.forEach(listener => listener());
    }, 0);
  }
}

const meshTopology = new MeshTopologyStore();

setInterval(() => {
  meshTopology.removeExpiredNodes();
}, CLEANUP_INTERVAL_MS);

export default meshTopology;
